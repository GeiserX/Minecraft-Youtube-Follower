{
  "name": "minecraft-spectator-bot",
  "version": "1.0.0",
  "description": "Mineflayer bot for following players in spectator mode",
  "main": "spectator-bot.js",
  "scripts": {
    "start": "node spectator-bot.js",
    "test": "jest --coverage"
  },
  "dependencies": {
    "mineflayer": "latest",
    "prismarine-auth": "latest",
    "prismarine-viewer": "latest",
    "canvas": "^2.11.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "bot-logic.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "author": "",
  "license": "GPL-3.0"
}

